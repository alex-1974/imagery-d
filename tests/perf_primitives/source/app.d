module app;
import core.time : MonoTime;
import imagery.analysis.primitives : gaussianBlur, gaussianBlurParallel, sobel, sobelParallel, canny, cannyParallel, cannyPreview, cannyPreviewUbyte, cannyGradientParallel, cannyFromGradient, cannyFromGradientFrontier;
import raster.parallel_rows : ParallelRowsResult;
import std.algorithm.sorting : sort;
import std.stdio : writefln;
import std.string : toLower;
import std.conv : to;
enum warmups = 2, runs = 7;
long measureByte(size_t w,size_t h,size_t workers){auto n=w*h;auto src=new ubyte[](n);auto e=new ubyte[](n);foreach(i;0..n)src[i]=cast(ubyte)((i*37)&255);auto t=MonoTime.currTime;foreach(i;0..warmups+runs)cannyPreviewUbyte(src,w,h,30,e,workers,32);return(MonoTime.currTime-t).total!"nsecs"/runs;}
long measure(size_t w, size_t h, size_t op, size_t workers=1) { auto n=w*h; auto src=new float[](n); auto a=new float[](n); auto b=new float[](n); auto e=new ubyte[](n); auto m=new float[](n); foreach(i;0..n)src[i]=cast(float)((i*37)&255)/255.0f; auto t0=MonoTime.currTime; foreach(i;0..warmups+runs){if(op==0)gaussianBlur(src,w,h,1.2f,a);else if(op==1)sobel(src,w,h,a,b);else if(op==2)canny(src,w,h,0.15f,0.3f,e);else if(op==5)gaussianBlurParallel(src,w,h,1.2f,a,workers,32);else if(op==6)sobelParallel(src,w,h,a,b,workers,32);else if(op==7)cannyParallel(src,w,h,0.15f,0.3f,e,workers,32);else if(op==8)cannyPreview(src,w,h,0.3f,e,workers,32);else {cannyGradientParallel(src,w,h,a,b,m,workers,32);if(op==3)cannyFromGradient(a,b,m,w,h,0.15f,0.3f,e);else cannyFromGradientFrontier(a,b,m,w,h,0.15f,0.3f,e);}} return (MonoTime.currTime-t0).total!"nsecs"/(runs); }
void main(string[] args) { bool fourK=args.length>1 && toLower(args[1])=="4k"; auto dims=fourK?[[3840,2160]]:[[1920,1080]]; auto workers=args.length>3?cast(size_t)args[3].to!size_t:1; if(args.length>2&&toLower(args[2])=="preview-ubyte"){foreach(dim;dims){long[] times;foreach(i;0..runs)times~=measureByte(dim[0],dim[1],workers);times.sort();writefln("preview-ubyte %dx%d workers=%d median=%.3fms p95=%.3fms",dim[0],dim[1],workers,times[$/2]/1_000_000.0,times[$-1]/1_000_000.0);}return;} int selected=-1;if(args.length>2){auto k=toLower(args[2]);selected=k=="gaussian"?0:k=="sobel"?1:k=="canny"?2:k=="canny-parallel"?3:k=="frontier"?4:k=="gaussian-parallel"?5:k=="sobel-parallel"?6:k=="canny-fast"?7:k=="preview"?8:-1;} foreach(dim;dims) foreach(op;0..9) if(selected<0||selected==op){long[] times;foreach(i;0..runs)times~=measure(dim[0],dim[1],op,workers);times.sort();writefln("%s %dx%d workers=%d median=%.3fms p95=%.3fms",op==0?"gaussian":op==1?"sobel":op==2?"canny":op==3?"canny-parallel":op==4?"frontier":op==5?"gaussian-parallel":op==6?"sobel-parallel":op==7?"canny-fast":"preview",dim[0],dim[1],workers,times[$/2]/1_000_000.0,times[$-1]/1_000_000.0);} }
