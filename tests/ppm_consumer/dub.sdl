name "m3-levels-production-ppm"
description "P6 image I/O app consuming the ordinary imagery-d package"
authors "Alexander Bernardi"
license "MIT"
targetType "executable"
sourcePaths "source"
dependency "imagery-d" path="../.."
dependency "imageio-d" version="~>0.1.0"
dependency "transport-d" version="~>0.2.1"
dependency "error-d" version="~>0.4.2"
dependency "compression-d" version="~>0.3.0"
dependency "containers-d" version="~>0.3.1"
dependency "mir-algorithm" version="~>3.22.5"
dependency "mir-core" version="~>1.7.4"
dependency "silly" version="~>1.1.1"
