name "m3-rgba-layer-compositing"
description "Research-only decoded RGBA image layer source-over adapter"
authors "Alexander Bernardi"
license "BSL-1.0"
targetType "library"
sourcePaths "source/imagery"
importPaths "source"
dflags "-preview=dip1000"

dependency "raster-d" path="../../../raster-d"
dependency "color-d" path="../../../color-d"

configuration "default" {
}

# Only selected through the explicitly opt-in independent native-fault
# consumer's subConfiguration. Does not enter default experiments or release.
configuration "native-faults" {
    versions "M3_OWNED_NATIVE_FAULTS"
}
