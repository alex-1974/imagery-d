name "m3-2-borrow-snapshot"
description "M3.2.5 research comparison of borrow-only and immutable snapshot metadata"
authors "Alexander Bernardi"
license "BSL-1.0"
targetType "executable"
sourcePaths "source"
importPaths "source" "../m1_5_image_view_contract/source" "../m3_2_semantic_display/source" "../m3_2_retained_metadata/source" "../m3_2_dynamic_metadata/source"
sourceFiles "../m1_5_image_view_contract/source/m1_5_image_view/contract.d"
sourceFiles "../m3_2_semantic_display/source/m3_2_channel_metadata/contract.d"
sourceFiles "../m3_2_retained_metadata/source/m3_2_retained_metadata/contract.d"
sourceFiles "../m3_2_dynamic_metadata/source/m3_2_dynamic_metadata/contract.d"
dflags "-preview=dip1000"

dependency "raster-d" path="../../../raster-d"

configuration "default" {
}
configuration "negative-caller-metadata-escape" {
    versions "M325_NEGATIVE_CALLER_METADATA_ESCAPE"
}
