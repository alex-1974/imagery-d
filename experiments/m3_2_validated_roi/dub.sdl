name "m3-2-validated-immutable-roi"
description "M3.2.6 source-independent ROI optimization contract for immutable metadata"
authors "Alexander Bernardi"
license "BSL-1.0"
targetType "executable"
sourcePaths "source"
importPaths "source" "../m1_5_image_view_contract/source" "../m3_2_semantic_display/source" "../m3_2_retained_metadata/source"
sourceFiles "../m1_5_image_view_contract/source/m1_5_image_view/contract.d"
sourceFiles "../m3_2_semantic_display/source/m3_2_channel_metadata/contract.d"
sourceFiles "../m3_2_retained_metadata/source/m3_2_retained_metadata/contract.d"
dflags "-preview=dip1000"

dependency "raster-d" path="../../../raster-d"

configuration "default" {
}
configuration "negative-primary-escape" {
    versions "M326_NEGATIVE_PRIMARY_ESCAPE"
}
configuration "negative-validity-escape" {
    versions "M326_NEGATIVE_VALIDITY_ESCAPE"
}
configuration "negative-metadata-escape" {
    versions "M326_NEGATIVE_METADATA_ESCAPE"
}
configuration "negative-roi-escape" {
    versions "M326_NEGATIVE_ROI_ESCAPE"
}
configuration "negative-mutable-metadata" {
    versions "M326_NEGATIVE_MUTABLE_METADATA"
}

configuration "negative-forged-capability" {
    versions "M326_NEGATIVE_FORGED_CAPABILITY"
}

configuration "negative-prepared-owner-escape" {
    versions "M329_NEGATIVE_OWNER_ESCAPE"
}
configuration "negative-prepared-forgery" {
    versions "M329_NEGATIVE_FORGED_PREPARED"
}

configuration "negative-prepared-metadata-escape" {
    versions "M329_NEGATIVE_METADATA_ESCAPE"
}

configuration "negative-sealed-direct-kernel" {
    versions "M3211_NEGATIVE_DIRECT_KERNEL"
}
configuration "negative-sealed-forged-execution" {
    versions "M3211_NEGATIVE_FORGED_EXECUTION"
}

configuration "negative-unified-verified-forgery" {
    versions "M3212_NEGATIVE_VERIFIED_TOKEN_FORGERY"
}

configuration "negative-m3217-mutable-freeze" {
    versions "M3217_NEGATIVE_MUTABLE_FREEZE"
}
configuration "negative-m3217-const-freeze" {
    versions "M3217_NEGATIVE_CONST_FREEZE"
}

configuration "negative-m3219-primary-escape" {
    versions "M3219_NEGATIVE_SOURCE_PRIMARY_ESCAPE"
}
configuration "negative-m3219-validity-escape" {
    versions "M3219_NEGATIVE_SOURCE_VALIDITY_ESCAPE"
}
