name "imagery-d"
description "General-purpose high-performance image processing in D"
homepage "https://github.com/alex-1974/imagery-d"
authors "Alexander Bernardi"
copyright "Copyright © 2026, Alexander Bernardi"
license "MIT"
toolchainRequirements frontend=">=2.111.0"
targetType "library"
sourcePaths "source"
dependency "raster-d" version="~>0.5.5"
dependency "color-d" version="~>0.4.0"

// Standard file/URL image ingestion. The core processing API remains
// usable through the no-io configuration for consumers that provide data
// directly.
configuration "default" {
    dependency "imageio-d" version="~>0.1.1"
    dependency "transport-d" version="~>0.2.1"
    versions "imageio_io"
}

configuration "no-io" {
    sourceFiles "source/imagery/package.d"
    sourceFiles "source/imagery/presentation/levels.d"
    sourceFiles "source/imagery/presentation/luminance_stretch.d"
    sourceFiles "source/imagery/analysis/rgb_histogram.d"
    sourceFiles "source/imagery/analysis/feature_regions.d"
    sourceFiles "source/imagery/analysis/feature_contracts.d"
    sourceFiles "source/imagery/analysis/feature_parameters.d"
    sourceFiles "source/imagery/analysis/window_kernels.d"
    sourceFiles "source/imagery/analysis/path_kernels.d"
    sourceFiles "source/imagery/analysis/feature_worker32.d"
    sourceFiles "source/imagery/analysis/feature_output32.d"
    sourceFiles "source/imagery/analysis/colour_indices.d"
    sourceFiles "source/imagery/analysis/cost_path.d"
    sourceFiles "source/imagery/analysis/lazy_cost_path.d"
    sourceFiles "source/imagery/analysis/row_kernels.d"
    sourceFiles "source/imagery/analysis/planar_cache.d"
    sourceFiles "source/imagery/analysis/canny_worker.d"
    sourceFiles "source/imagery/analysis/quality.d"
    sourceFiles "source/imagery/analysis/structure_tensor.d"
    sourceFiles "source/imagery/analysis/hessian_lines.d"
    sourceFiles "source/imagery/mosaic/validity_policy.d"
    sourceFiles "source/imagery/mosaic/decoded_tile_mosaic.d"
    sourceFiles "source/imagery/mosaic/multiresolution.d"
    sourceFiles "source/imagery/pyramid/overview_selection.d"
    sourceFiles "source/imagery/analysis/feature_evidence.d"
    sourceFiles "source/imagery/analysis/feature_structure.d"
    sourceFiles "source/imagery/analysis/feature_components.d"
    sourceFiles "source/imagery/analysis/color_slic.d"
    sourceFiles "source/imagery/analysis/region_graph.d"
    sourceFiles "source/imagery/analysis/feature_segmentation.d"
    sourceFiles "source/imagery/analysis/feature_overviews.d"
    sourceFiles "source/imagery/analysis/feature_requests.d"
    sourceFiles "source/imagery/materialization.d"
}

// Separate unittest builds must emit imported color-d instantiations.
buildType "unittest" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "-allinst" platform="dmd"
    dflags "--allinst" platform="ldc"
}

subPackage {
    name "bench"
    targetType "executable"
    sourcePaths "benchmark/source"
    dependency "imagery-d" path="."
    subConfiguration "imagery-d" "no-io"
}
